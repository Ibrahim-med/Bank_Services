# Copy this file to ".env" (same folder) and fill in the values.
# The backend reads it automatically at startup. NEVER commit the real .env.

# MySQL account (the database is created automatically if it does not exist)
DB_USERNAME=root
DB_PASSWORD=change-me
# Optional - default: jdbc:mysql://localhost:3306/bankservices?createDatabaseIfNotExist=true
# DB_URL=jdbc:mysql://localhost:3306/bankservices?createDatabaseIfNotExist=true

# JWT signing key: a Base64 string of at least 32 bytes.
# Generate one with:  openssl rand -base64 48
# Demo key below works locally - replace it for any real deployment.
JWT_SECRET=replace-with-your-own-base64-secret

# Optional - Gmail SMTP account (app password) used for e-mail notifications,
# account activation and password reset links. Leave empty to disable e-mails.
MAIL_USERNAME=
MAIL_PASSWORD=
